# Conexión a PostgreSQL (Prisma ORM 7)
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facturastock?schema=public"

# Opcionales: configuración del pool de conexiones de `pg`
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000


NUBEFACT_API_URL="https://api.nubefact.com/api/v1/00000000-0000-0000-0000-000000000000"
NUBEFACT_API_TOKEN="your-nubefact-token"
   
# Decolecta (consulta de DNI en RENIEC y RUC en SUNAT)
DECOLECTA_API_TOKEN="your-decolecta-token"

# Cloudinary (subida de imágenes de productos)
# El cloud name y el API key son públicos; el secret solo se usa en el servidor.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Autenticación (Better Auth)
# Secreto para firmar las cookies de sesión. Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-32-byte-secret"
# URL pública de la aplicación.
BETTER_AUTH_URL="http://localhost:3000"
# "true" abre el registro de cuentas. Cada cuenta nueva tiene permisos de
# escritura (puede vender y emitir comprobantes): déjalo cerrado en una demo pública.
AUTH_ALLOW_SIGNUP="false"

# Usuario de demostración de solo lectura (opcional). `pnpm db:seed` crea la
# cuenta con estas credenciales y el botón "Entrar como demo" del login las usa
# desde el servidor; nunca se envían al navegador. Sin ellas, el botón no aparece.
DEMO_USER_EMAIL=""
DEMO_USER_PASSWORD=""

# Administrador que crea `pnpm db:seed` (opcional).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# SEED_ADMIN_NAME="Administrador"
