// Esquema de Prisma para la aplicación de inventario.
// Documentación: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Clientes
// ---------------------------------------------------------------------------

enum CustomerDocumentType {
  DNI
  RUC
}

model Customer {
  id           String               @id @default(uuid()) @db.Uuid
  documentType CustomerDocumentType @default(DNI) @map("document_type")
  dni          String?              @unique @db.VarChar(8)
  ruc          String?              @unique @db.VarChar(11)
  firstName    String?              @map("first_name") @db.VarChar(80)
  lastName     String?              @map("last_name") @db.VarChar(80)
  businessName String?              @map("business_name") @db.VarChar(160)
  address      String               @db.VarChar(200)
  phone        String?              @db.VarChar(20)
  email        String?              @unique @db.VarChar(120)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  sales Sale[]

  @@map("customers")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(120)
  sku           String   @unique @db.VarChar(50)
  description   String?  @db.VarChar(255)
  price         Decimal  @db.Decimal(10, 2)
  stock         Int      @default(0)
  isActive      Boolean  @default(true) @map("is_active")
  imageUrl      String?  @map("image_url") @db.VarChar(500)
  imagePublicId String?  @map("image_public_id") @db.VarChar(255)
  categoryId    String   @map("category_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  saleItems SaleItem[]

  @@index([categoryId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Ventas
// ---------------------------------------------------------------------------

enum SaleStatus {
  COMPLETADA
  ANULADA
}

model Sale {
  id         String     @id @default(uuid()) @db.Uuid
  number     Int        @unique @default(autoincrement())
  customerId String?    @map("customer_id") @db.Uuid
  total      Decimal    @db.Decimal(10, 2)
  status     SaleStatus @default(COMPLETADA)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  invoice  Invoice?

  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(uuid()) @db.Uuid
  saleId      String   @map("sale_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(120)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

enum InvoiceDocumentType {
  FACTURA
  BOLETA
}

enum InvoiceStatus {
  PENDIENTE
  EMITIDO
  ANULADO
  ANULACION_PENDIENTE
}

// Correlativo por serie. FFF1 empieza en 8 y BBB1 en 6 (ver migración).
model InvoiceCounter {
  series     String   @id @db.VarChar(4)
  nextNumber Int      @map("next_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("invoice_counters")
}

// Comprobante electrónico emitido en Nubefact, uno por venta.
model Invoice {
  id                String              @id @default(uuid()) @db.Uuid
  saleId            String              @unique @map("sale_id") @db.Uuid
  documentType      InvoiceDocumentType @map("document_type")
  invoiceType       Int                 @map("invoice_type")
  series            String              @db.VarChar(4)
  number            Int
  status            InvoiceStatus       @default(PENDIENTE)
  sunatAccepted     Boolean?            @map("sunat_accepted")
  sunatDescription  String?             @map("sunat_description") @db.Text
  sunatNote         String?             @map("sunat_note") @db.Text
  sunatResponseCode String?             @map("sunat_response_code") @db.VarChar(20)
  pdfUrl            String?             @map("pdf_url") @db.Text
  xmlUrl            String?             @map("xml_url") @db.Text
  cdrUrl            String?             @map("cdr_url") @db.Text
  hash              String?             @db.VarChar(255)
  qrString          String?             @map("qr_string") @db.Text
  errorMessage      String?             @map("error_message") @db.Text
  response          Json?
  issuedAt          DateTime?           @map("issued_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([series, number])
  @@map("invoices")
}
