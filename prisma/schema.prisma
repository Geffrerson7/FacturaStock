// Esquema de Prisma para la aplicación de inventario.
// Documentación: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Clientes
// ---------------------------------------------------------------------------

enum CustomerDocumentType {
  DNI
  RUC
}

model Customer {
  id           String               @id @default(uuid()) @db.Uuid
  documentType CustomerDocumentType @default(DNI) @map("document_type")
  dni          String?              @unique @db.VarChar(8)
  ruc          String?              @unique @db.VarChar(11)
  firstName    String?              @map("first_name") @db.VarChar(80)
  lastName     String?              @map("last_name") @db.VarChar(80)
  businessName String?              @map("business_name") @db.VarChar(160)
  address      String               @db.VarChar(200)
  phone        String?              @db.VarChar(20)
  email        String?              @unique @db.VarChar(120)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  sales Sale[]

  @@map("customers")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(120)
  sku               String   @unique @db.VarChar(50)
  description       String?  @db.VarChar(255)
  price             Decimal  @db.Decimal(10, 2)
  // Precio mínimo de venta (con IGV). Ninguna venta puede cobrar menos. Sin
  // valor, el mínimo es el propio precio de lista.
  minPrice          Decimal? @map("min_price") @db.Decimal(10, 2)
  stock             Int      @default(0)
  // El producto tiene "stock bajo" cuando stock <= lowStockThreshold.
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  // Valorización del inventario (kárdex por costo promedio ponderado). Solo
  // las escribe el motor del kárdex (src/lib/kardex), igual que `stock`.
  lastCost          Decimal  @default(0) @map("last_cost") @db.Decimal(14, 6)
  averageCost       Decimal  @default(0) @map("average_cost") @db.Decimal(14, 6)
  inventoryValue    Decimal  @default(0) @map("inventory_value") @db.Decimal(14, 2)
  isActive          Boolean  @default(true) @map("is_active")
  imageUrl          String?  @map("image_url") @db.VarChar(500)
  imagePublicId     String?  @map("image_public_id") @db.VarChar(255)
  categoryId        String   @map("category_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Ventas
// ---------------------------------------------------------------------------

enum SaleStatus {
  COMPLETADA
  ANULADA
}

model Sale {
  id            String     @id @default(uuid()) @db.Uuid
  number        Int        @unique @default(autoincrement())
  customerId    String?    @map("customer_id") @db.Uuid
  // Usuario que registró la venta. Las ventas anteriores a este campo y las
  // de la demo no lo tienen.
  sellerId      String?    @map("seller_id")
  // Base imponible e IGV, calculados igual que en el comprobante.
  // taxableAmount + igvAmount = total.
  taxableAmount Decimal    @default(0) @map("taxable_amount") @db.Decimal(10, 2)
  igvAmount     Decimal    @default(0) @map("igv_amount") @db.Decimal(10, 2)
  total         Decimal    @db.Decimal(10, 2)
  status        SaleStatus @default(COMPLETADA)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  seller   User?      @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  invoice  Invoice?

  @@index([customerId])
  @@index([sellerId])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(uuid()) @db.Uuid
  saleId      String   @map("sale_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(120)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  // Precio de lista del producto al vender (snapshot), para comparar con el
  // precio cobrado. Nulo en ventas anteriores a este campo.
  listPrice   Decimal? @map("list_price") @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

enum InvoiceDocumentType {
  FACTURA
  BOLETA
}

enum InvoiceStatus {
  PENDIENTE
  EMITIDO
  ANULADO
  ANULACION_PENDIENTE
}

// Correlativo por serie. Las series y su número inicial salen de las
// variables NUBEFACT_*_SERIES y NUBEFACT_*_INITIAL_NUMBER.
model InvoiceCounter {
  series     String   @id @db.VarChar(4)
  nextNumber Int      @map("next_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("invoice_counters")
}

// Comprobante electrónico emitido en Nubefact, uno por venta.
model Invoice {
  id                String              @id @default(uuid()) @db.Uuid
  saleId            String              @unique @map("sale_id") @db.Uuid
  documentType      InvoiceDocumentType @map("document_type")
  invoiceType       Int                 @map("invoice_type")
  series            String              @db.VarChar(4)
  number            Int
  status            InvoiceStatus       @default(PENDIENTE)
  sunatAccepted     Boolean?            @map("sunat_accepted")
  sunatDescription  String?             @map("sunat_description") @db.Text
  sunatNote         String?             @map("sunat_note") @db.Text
  sunatResponseCode String?             @map("sunat_response_code") @db.VarChar(20)
  pdfUrl            String?             @map("pdf_url") @db.Text
  xmlUrl            String?             @map("xml_url") @db.Text
  cdrUrl            String?             @map("cdr_url") @db.Text
  hash              String?             @db.VarChar(255)
  qrString          String?             @map("qr_string") @db.Text
  errorMessage      String?             @map("error_message") @db.Text
  response          Json?
  issuedAt          DateTime?           @map("issued_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([series, number])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Kárdex
// ---------------------------------------------------------------------------
// Cada entrada o salida de stock es una fila. El saldo (cantidad, costo
// promedio y valor) después del movimiento se guarda en la misma fila, así el
// saldo anterior a cualquier fecha se lee sin recalcular. Compatible con el
// Formato 13.1 de SUNAT (registro de inventario permanente valorizado).

enum StockMovementType {
  SALDO_INICIAL
  INGRESO
  AJUSTE_POSITIVO
  VENTA
  ANULACION_VENTA
  AJUSTE_NEGATIVO
  MERMA
  // Cambia el valor y el costo promedio, no las unidades.
  AJUSTE_VALORIZACION
}

enum StockMovementDirection {
  ENTRADA
  SALIDA
  NINGUNA
}

// Origen del movimiento. PURCHASE queda reservado para el módulo de compras.
enum StockReferenceType {
  MANUAL
  SALE
  SALE_CANCELLATION
  PURCHASE
}

model StockMovement {
  id                 String                 @id @default(uuid()) @db.Uuid
  productId          String                 @map("product_id") @db.Uuid
  // Correlativo por producto: fija el orden del kárdex y hace fallar dos
  // escrituras simultáneas en lugar de descuadrar el saldo.
  sequence           Int
  type               StockMovementType
  direction          StockMovementDirection
  // Tabla 12 de SUNAT (tipo de operación), guardada para que el historial no
  // cambie si cambia el mapeo.
  sunatOperationCode String                 @map("sunat_operation_code") @db.VarChar(2)
  quantity           Int
  unitCost           Decimal                @map("unit_cost") @db.Decimal(14, 6)
  // Con signo en los ajustes de valorización; positivo en el resto.
  totalCost          Decimal                @map("total_cost") @db.Decimal(14, 2)
  balanceQuantity    Int                    @map("balance_quantity")
  balanceAverageCost Decimal                @map("balance_average_cost") @db.Decimal(14, 6)
  balanceValue       Decimal                @map("balance_value") @db.Decimal(14, 2)
  // Tabla 10 de SUNAT: 01 factura, 03 boleta, 00 otros.
  documentType       String                 @default("00") @map("document_type") @db.VarChar(2)
  documentSeries     String?                @map("document_series") @db.VarChar(4)
  documentNumber     Int?                   @map("document_number")
  referenceType      StockReferenceType     @map("reference_type")
  referenceId        String?                @map("reference_id") @db.Uuid
  // Salida que revierte esta entrada (anulación de una venta).
  reversesMovementId String?                @map("reverses_movement_id") @db.Uuid
  reason             String?                @db.VarChar(255)
  userId             String?                @map("user_id")
  occurredAt         DateTime               @default(now()) @map("occurred_at")
  createdAt          DateTime               @default(now()) @map("created_at")

  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  reversesMovement StockMovement?  @relation("MovementReversal", fields: [reversesMovementId], references: [id], onDelete: SetNull)
  reversals        StockMovement[] @relation("MovementReversal")

  @@unique([productId, sequence])
  @@index([productId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Autenticación (Better Auth)
// ---------------------------------------------------------------------------
// Los nombres de los modelos y de los campos son los que espera Better Auth;
// solo cambian los nombres de las tablas y columnas con @map.

enum UserRole {
  ADMIN
  // Cuentas creadas desde /register: ventas, comprobantes y clientes, sin
  // administrar el catálogo, el kardex ni anular ventas.
  CASHIER
  // Usuario de demostración: solo lectura (peticiones GET).
  DEMO
}

model User {
  id            String   @id
  name          String   @db.VarChar(120)
  email         String   @unique @db.VarChar(120)
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?  @db.Text
  role          UserRole @default(CASHIER)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions       Session[]
  accounts       Account[]
  stockMovements StockMovement[]
  sales          Sale[]

  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address") @db.Text
  userAgent String?  @map("user_agent") @db.Text
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Una fila por método de acceso. La contraseña cifrada vive aquí, en la
// cuenta con providerId "credential".
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}
